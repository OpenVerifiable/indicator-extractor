{
  "name": "indicator-extractor",
  "version": "1.1.0",
  "type": "module",
  "description": "Server that processes files and returns Trust Indicator Set JSON results",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@contentauth/c2pa-node": "^0.5.1",
    "@trustnxt/c2pa-ts": "^0.8.0",
    "commander": "^14.0.0",
    "exifr": "^7.1.3",
    "express": "^5.2.1",
    "fs-extra": "^11.3.0",
    "multer": "^2.0.2",
    "path": "^0.12.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.14.9",
    "eslint": "^9.9.0",
    "jest": "^29.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
